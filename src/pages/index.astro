---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import Experience from '@/components/widgets/Experience.astro'
import Skills from '@/components/widgets/Skills.astro'
import PostList from '@/components/widgets/PostList.astro'
import { siteConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const posts = await getSortedFilteredPosts()
---

<IndexLayout title={siteConfig.site.title} description={siteConfig.site.description}>
  <About />
  <Experience />
  <Skills />
  <section class="writing" aria-labelledby="writing-heading">
    <h2 id="writing-heading" class="section-heading">Writing</h2>
    <PostList posts={posts} />
  </section>
</IndexLayout>

<style>
  .writing {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
