---
import { skillGroups } from '@/data/skills'

const toId = (title: string) => `skills-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
---

<section class="skills" aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="section-heading">Skills</h2>
  {
    skillGroups.map((group) => (
      <details class="group">
        <summary>
          <h3 id={toId(group.title)} class="group-heading">
            {group.title}
          </h3>
          <span class="count">{group.skills.length}</span>
          <svg class="chevron" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path
              d="M4 6l4 4 4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>
        <ul class="pills" aria-labelledby={toId(group.title)}>
          {group.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </details>
    ))
  }
</section>

<style>
  .skills {
    margin-bottom: 2.5rem;
  }

  .group {
    border-bottom: 0.5px solid var(--border);
  }

  summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--text-secondary);
    transition: color 0.2s ease-out;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  .group[open] summary {
    color: var(--text-primary);
  }

  .group-heading {
    margin: 0;
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-regular);
    color: inherit;
  }

  .count {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .chevron {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--text-secondary);
    transition: transform 0.2s ease-out;
  }

  .group[open] .chevron {
    transform: rotate(180deg);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0 0 1rem 0;
    margin: 0;
    list-style-type: none;
  }

  .pills li {
    padding: 0.125rem 0.625rem;
    font-size: var(--font-size-s);
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
</style>
