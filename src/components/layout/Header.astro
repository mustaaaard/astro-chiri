---
import { siteConfig } from '@/config'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
---

<header>
  <nav>
    <div class="identity">
      <div class="avatar">
        <img src="/dp.jpg" alt={siteConfig.site.author} width="88" height="88" />
      </div>
      <h1><a href="/">{siteConfig.site.title}</a></h1>
    </div>
    <ThemeToggle />
  </nav>
</header>
<style>
  header {
    margin: 0;
  }
  h1 {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .identity {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .avatar {
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  header a {
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
    min-width: 3rem;
    display: inline-block;
  }
</style>
